{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dec",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"dev": {
		"port": 6390,
		"inspector_port": 9390
	},
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
	// Database backend is Neon Postgres, reached over the DATABASE_URL secret
	// (Drizzle + @neondatabase/serverless) — not a Worker binding. Set it locally
	// in .dev.vars and in prod with `wrangler secret put DATABASE_URL`. Apply the
	// schema with `pnpm db:migrate` (see drizzle.config.ts).
}