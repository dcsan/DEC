{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dec",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"dev": {
		"port": 6390,
		"inspector_port": 9390
	},
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// D1 — stores decision boards, canvas nodes/edges and chat messages.
	// Create with: pnpm wrangler d1 create dec-db
	// Paste the returned database_id below, then run: pnpm db:migrate:local
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dec-db",
			"database_id": "REPLACE_WITH_DATABASE_ID",
			"migrations_dir": "migrations"
		},
		{
			"binding": "dec_db",
			"database_name": "dec-db",
			"database_id": "9281afae-1b2f-4d8b-9e38-d4162fa35806",
			"remote": true
		}
	]
}