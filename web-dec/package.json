{
  "name": "dec",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\" --names \"API,CLIENT\" --prefix-colors \"blue,magenta\"",
    "dev:server": "pnpm run build:widgets && pnpm run build:client && wrangler dev --port ${PORT_SERVER:-6390}",
    "dev:client": "vite",
    "build": "pnpm run build:widgets && pnpm run build:client && wrangler deploy --dry-run --outdir=dist/worker",
    "build:client": "vite build",
    "build:widgets": "node scripts/build-widgets.mjs",
    "deploy": "pnpm run build:widgets && pnpm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "eval:router": "tsx test/routerEval.ts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx --yes @better-auth/cli@latest generate --config src/auth/cli.ts --output src/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.1.2",
    "@hono/mcp": "0.3.0",
    "@hono/trpc-server": "^0.4.0",
    "@modelcontextprotocol/ext-apps": "1.7.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.25",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@xyflow/react": "^12.3.5",
    "better-auth": "1.6.13",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "superjson": "^2.2.6",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "wrangler": "^4.85.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "kysely": "0.28.17"
    }
  }
}
