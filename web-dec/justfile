# https://github.com/casey/just

set dotenv-load

default:
  @just --list

cls:
  clear && printf '\e[3J'


########## build and deploy ##########

cf-login:
  npx wrangler login

cf-auth-check:
  bash scripts/cf-auth-check.sh

# run this after modifying wrangler.jsonc eg for new env vars
cf-types:
  npx wrangler types

clean-files:
  find . -name '.DS_Store' -type f -delete
  @echo "Removed all .DS_Store files"

lint: cls
  pnpm run typecheck

build: cf-types
  pnpm run build

deploy: cf-auth-check clean-files build
  npx wrangler deploy


########## dev ##########

# run front and back
dev: cls cf-types
  pnpm run dev

dev-client:
  pnpm run dev:client

dev-server:
  pnpm run dev:server


########## test / eval ##########

# Eval the convo router's widget choice against the fixed question set in
# test/routerCases.ts. Uses OPENROUTER_API_KEY from .dev.vars (LLM path) or
# falls back to the keyless heuristic. Pass extra flags through, e.g.
#   just eval-router --quiet --concurrency=10
eval-router *FLAGS:
  pnpm tsx test/routerEval.ts {{FLAGS}}


########## cloudflare ##########

secrets-put-all:
  npx wrangler secret bulk .dev.vars

secrets-put-one name="OPENROUTER_API_KEY" value="":
  npx wrangler secret put "{{name}}"

login:
  npx wrangler login

# Stream live logs from the deployed Worker (production). Filter with
# --status error / --method POST / --search "board.get" etc.
# Usage: just logs-tail
#        just logs-tail --status error
logs-tail *args:
  npx wrangler tail dec --format pretty {{args}}

# Same as logs-tail but pre-filtered to errors only.
logs-errors:
  npx wrangler tail dec --format pretty --status error


########## database (Neon Postgres + Drizzle) ##########

# Generate a new migration SQL file from src/db/schema.ts diffs (→ drizzle/).
# Offline — no DB connection needed. Commit the new file.
migrations-generate:
  pnpm run db:generate

# Apply pending migrations to the Neon database at DATABASE_URL (from .dev.vars).
# Run this before `just deploy` whenever the schema changed.
migrations-apply:
  set -a && source .dev.vars && set +a && pnpm run db:migrate

# Push the schema straight to the database without a migration file — handy in
# dev. Prefer migrations-generate + migrations-apply for anything shared.
db-push:
  set -a && source .dev.vars && set +a && pnpm run db:push

# Open Drizzle Studio in the browser, pointed at the Neon database.
db-studio:
  set -a && source .dev.vars && set +a && pnpm run db:studio

# Run an arbitrary SQL command against the Neon database via psql.
# Usage: just db-sql "SELECT count(*) FROM boards"
db-sql cmd:
  set -a && source .dev.vars && set +a && psql "$DATABASE_URL" -c "{{cmd}}"


switch-env env='dev': cls
  #!/usr/bin/env bash
  echo "Switching to [{{env}}] environment..."
  rm .env
  if [[ "{{env}}" == "dev" ]]; then
    ln -sf bin/creds/.env.dev .env
    ln -sf bin/creds/.env.dev .dev.vars
    echo "Copied .env.dev to .env"
  elif [[ "{{env}}" == "prod" ]]; then
    ln -sf bin/creds/.env.prod .env
    ln -sf bin/creds/.env.prod .dev.vars
    echo "Copied .env.prod to .env"
  else
    echo "Unknown environment: {{env}}. Use 'dev' or 'prod'."
    exit 1
  fi

  head .env
