# https://github.com/casey/just

set dotenv-load

default:
  @just --list

cls:
  clear && printf '\e[3J'


########## build and deploy ##########

cf-login:
  npx wrangler login

cf-auth-check:
  bash scripts/cf-auth-check.sh

# run this after modifying wrangler.jsonc eg for new env vars
cf-types:
  npx wrangler types

clean-files:
  find . -name '.DS_Store' -type f -delete
  @echo "Removed all .DS_Store files"

lint: cls
  pnpm run typecheck

build: cf-types
  pnpm run build

deploy: cf-auth-check clean-files build
  npx wrangler deploy


########## dev ##########

# run front and back
dev: cls cf-types
  pnpm run dev

dev-client:
  pnpm run dev:client

dev-server:
  pnpm run dev:server


########## cloudflare ##########

secrets-put-all:
  npx wrangler secret bulk .dev.vars

secrets-put-one name="OPENROUTER_API_KEY" value="":
  npx wrangler secret put "{{name}}"

login:
  npx wrangler login

# Stream live logs from the deployed Worker (production). Filter with
# --status error / --method POST / --search "board.get" etc.
# Usage: just logs-tail
#        just logs-tail --status error
logs-tail *args:
  npx wrangler tail dec --format pretty {{args}}

# Same as logs-tail but pre-filtered to errors only.
logs-errors:
  npx wrangler tail dec --format pretty --status error


########## database (D1 + Drizzle) ##########

# One-time: create the D1 database, then paste the returned id into
# wrangler.jsonc d1_databases[0].database_id.
db-create:
  npx wrangler d1 create dec-db

# Generate a new migration SQL file from src/db/schema.ts diffs.
# Output goes to migrations/. Commit the new file.
migrations-generate:
  pnpm run db:generate

# Manually create an empty timestamped migration file (rare — usually you
# want migrations-generate). Useful for ad-hoc data backfills.
# Usage: just migrations-create "add_node_color"
migrations-create name:
  pnpm wrangler d1 migrations create dec-db "{{name}}"

# Show pending vs applied migrations on the LOCAL D1.
migrations-list-local:
  pnpm wrangler d1 migrations list dec-db --local

# Show pending vs applied migrations on the PRODUCTION D1.
migrations-list-remote:
  set -a && source .dev.vars && set +a && \
    CLOUDFLARE_API_TOKEN="$CLOUDFLARE_D1_TOKEN" \
    pnpm wrangler d1 migrations list dec-db --remote

# Apply pending migrations to the local D1 (the .wrangler/state SQLite).
migrations-local:
  pnpm run db:migrate:local

# Apply pending migrations to the PRODUCTION D1.
# Run this before `just deploy` whenever the schema changed.
migrations-remote:
  set -a && source .dev.vars && set +a && \
    CLOUDFLARE_API_TOKEN="$CLOUDFLARE_D1_TOKEN" \
    pnpm run db:migrate:remote

# Open Drizzle Studio in the browser, pointed at the LOCAL D1.
# Auto-resolves the active miniflare sqlite file (newest mtime in
# .wrangler/state/v3/d1/miniflare-D1DatabaseObject/, ignoring metadata.sqlite).
# Run `pnpm dev:server` at least once first so the file exists.
db-studio-local:
  #!/usr/bin/env bash
  set -euo pipefail
  dir=".wrangler/state/v3/d1/miniflare-D1DatabaseObject"
  if [ ! -d "$dir" ]; then
    echo "no local D1 found at $dir — run 'pnpm dev:server' or 'just migrations-local' first" >&2
    exit 1
  fi
  db=$(ls -t "$dir"/*.sqlite 2>/dev/null | grep -v '/metadata.sqlite$' | head -n1)
  if [ -z "$db" ]; then
    echo "no local D1 sqlite file in $dir — run 'just migrations-local' to create it" >&2
    exit 1
  fi
  echo "→ $db"
  LOCAL_D1_PATH="$db" pnpm drizzle-kit studio --config=drizzle.local.config.ts

# Open Drizzle Studio in the browser, pointed at the REMOTE D1.
# Requires CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_DATABASE_ID, and
# CLOUDFLARE_D1_TOKEN in .dev.vars (token scope: D1:Edit).
db-studio-remote:
  set -a && source .dev.vars && set +a && pnpm drizzle-kit studio --config=drizzle.remote.config.ts

# Run an arbitrary SQL command against the LOCAL D1.
# Usage: just db-sql-local "SELECT count(*) FROM boards"
db-sql-local cmd:
  pnpm wrangler d1 execute dec-db --local --command="{{cmd}}"

# Run an arbitrary SQL command against the REMOTE D1.
# Usage: just db-sql-remote "SELECT count(*) FROM boards"
db-sql-remote cmd:
  pnpm wrangler d1 execute dec-db --remote --command="{{cmd}}"


switch-env env='dev': cls
  #!/usr/bin/env bash
  echo "Switching to [{{env}}] environment..."
  rm .env
  if [[ "{{env}}" == "dev" ]]; then
    ln -sf bin/creds/.env.dev .env
    ln -sf bin/creds/.env.dev .dev.vars
    echo "Copied .env.dev to .env"
  elif [[ "{{env}}" == "prod" ]]; then
    ln -sf bin/creds/.env.prod .env
    ln -sf bin/creds/.env.prod .dev.vars
    echo "Copied .env.prod to .env"
  else
    echo "Unknown environment: {{env}}. Use 'dev' or 'prod'."
    exit 1
  fi

  head .env
