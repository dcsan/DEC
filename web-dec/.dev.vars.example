# Copy to .dev.vars and fill in. .dev.vars is git-ignored.

# Postgres (Neon) connection string — the database backend. Used by the Worker
# (Drizzle/neon-http) and by drizzle-kit migrations (db:generate/migrate/push).
# Create a project at https://neon.tech and copy its pooled connection string.
DATABASE_URL=

# LLM for the convo router, recommendations, /research, /viz, /summary, etc.
# Without it the app still runs — those features fall back to deterministic
# stubs. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Conversational memory store for /context, /facts, /research session recall.
# Optional — those features report Honcho isn't configured without it.
HONCHO_API_KEY=

# you.com Research API — powers /research (multi-step web research with
# citations). Optional: without it /research falls back to OpenRouter's web
# search. Get a key at https://you.com/platform
YDC_API_KEY=

# Better Auth (Phase 5c). Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the auth server (the tunnel/prod origin). OAuth issuer.
BETTER_AUTH_URL=https://dec.visithink.net
